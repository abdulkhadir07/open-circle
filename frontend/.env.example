# Public, non-secret configuration only — VITE_* variables are inlined into
# the client bundle and exposed to every visitor's browser.
#
# In development, /api and /ws are proxied to the backend by Vite (see
# vite.config.ts) and requests use relative paths, so these are not needed
# locally. They exist for a future production deployment where the frontend
# and backend are served from separate hosts.

# VITE_API_BASE_URL=https://api.opencircle.example.com
# VITE_WS_URL=wss://api.opencircle.example.com/ws
